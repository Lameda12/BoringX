{
  "name": "boringx",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Small tools that each do one dull job, entirely in your browser.",
  "scripts": {
    "gen": "tsx --tsconfig scripts/tsconfig.json scripts/gen-registry.ts",
    "predev": "npm run gen && node scripts/copy-assets.mjs && node scripts/make-og.mjs",
    "dev": "next dev",
    "prebuild": "npm run gen && node scripts/copy-assets.mjs && node scripts/make-og.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@imgly/background-removal": "^1.4.5",
    "@imgly/background-removal-data": "^1.4.5",
    "@jsquash/avif": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
